# TrueX FIX Protocol Configuration
TRUEX_API_KEY=your-truex-api-key
TRUEX_API_SECRET=your-truex-api-secret
TRUEX_SECRET_KEY=your-truex-secret-key
TRUEX_CLIENT_ID=your-client-id
TRUEX_SELF_MATCH_PREVENTION_INSTRUCTION=0
TRUEX_SENDER_COMP_ID=YOUR_SENDER_COMP_ID
# Required: resolve the exact ID from TrueX REST order_info.instrument_id.
# This is commonly numeric and is not the FIX symbol (for example, not BTC-PYUSD).
TRUEX_INSTRUMENT_ID=
# Required: choose a stable, account-unique 4-6 URL-safe maker prefix. There is
# deliberately no shared default; keep the chosen value unchanged across restarts.
TRUEX_ORDER_ID_NAMESPACE=

# TrueX FIX Connection Settings
TRUEX_FIX_HOST=129.212.145.83
TRUEX_FIX_PORT=3004
TRUEX_TARGET_COMP_ID=TRUEX_UAT_OE

# FIX Proxy Server (fix-proxy-server.js)
FIX_PROXY_PORT=3004                    # Port the proxy listens on
TRUEX_UPSTREAM_HOST=38.32.101.229      # TrueX FIX host to forward to (UAT default; prod uses TRUEX_PROD_HOST via docker-compose.prod.yml)
TRUEX_UPSTREAM_PORT=19484              # TrueX FIX port to forward to

# TrueX Production Host (internal IP reachable over WireGuard tunnel)
# Used by docker-compose.prod.yml to set FIX OE/MD upstream and REST URL.
# WireGuard AllowedIPs must include this IP. If TrueX moves the endpoint,
# update this var AND add the new /32 to /etc/wireguard/truemarkets.conf.
TRUEX_PROD_HOST=10.20.6.11

# TrueX REST API (Backup)
TRUEX_REST_BASE_URL=https://uat-api.truemarkets.co
TRUEX_WS_URL=wss://uat-api.truemarkets.co/ws

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database
DO_REDIS_URL=redis://:password@host:6379

# Trading Configuration
SYMBOL=BTC-PYUSD
ORDER_SIZE=0.01
SPREAD=0.50
TOTAL_ORDERS=50
PRICE_LEVELS=8
ORDER_PACING_MS=20
# Balance snapshot interval (ms). Stores portfolio value periodically for accurate P&L tracking. Default: 900000 (15 min)
BALANCE_SNAPSHOT_INTERVAL_MS=900000

# Maker continuity controls (required by scripts/run-prod.js)
# These are non-secret deployment obligations. Revalidate reserves and thresholds
# against the funded account and normal quote settings before each production rollout.
MM_MIN_ACTIVE_LEVELS_PER_SIDE=1
MM_MIN_FUNDED_QUOTE_SIZE_BTC=0.0001
MM_L1_RESERVE_BASE_BTC=0.01
MM_L1_RESERVE_QUOTE_PYUSD=1000
MM_MAX_SIDE_GAP_MS=5000
MM_SIDE_GAP_ALERT_THRESHOLD_MS=3000
MM_SIDE_GAP_ALERT_RATE_LIMIT_MS=60000
MM_DEGRADED_MAX_LEVELS=1
MM_DEGRADED_SIZE_FACTOR=0.5
MM_DEFENSIVE_SPREAD_FLOOR_BPS=80

# Strict TrueX maker marketability safety (required by scripts/run-prod.js).
# Coinbase prices quotes; only a fresh TrueX EBBO may authorize a maker D send.
# Use `slide` only through an evidence-backed canary because it changes economics.
TRUEX_MAKER_SAFETY_STRICT=true
TRUEX_MAKER_MARKETABLE_ACTION=skip
TRUEX_MAKER_EBBO_MAX_AGE_MS=3000
TRUEX_ALO_RETRY_COOLDOWN_MS=10000
TRUEX_ALO_RETRY_MAX_ENTRIES=256

# Coinbase WebSocket (for live market data)
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Reference mark-out evidence (observability only; default-off rollout switch)
REFERENCE_MARKOUT_ENABLED=false
REFERENCE_MARKOUT_PRODUCT=BTC-USD
REFERENCE_MARKOUT_QUOTE_CURRENCY=USD
REFERENCE_MARKOUT_SOURCE_EXCHANGE=coinbase
REFERENCE_MARKOUT_SOURCE_TYPE=top-of-book
REFERENCE_MARKOUT_HORIZONS_MS=60000,300000,3600000
REFERENCE_MARKOUT_MAX_SOURCE_AGE_MS=5000
REFERENCE_MARKOUT_MAX_LATENESS_MS=30000
REFERENCE_MARKOUT_POLL_INTERVAL_MS=1000
REFERENCE_MARKOUT_BATCH_SIZE=100
REFERENCE_MARKOUT_CLAIM_LEASE_MS=5000
REFERENCE_MARKOUT_RETENTION_MS=7776000000
REFERENCE_MARKOUT_RETENTION_SWEEP_INTERVAL_MS=3600000
REFERENCE_MARKOUT_AUDIT_MAX_GROUPS=500
REFERENCE_MARKOUT_MAX_ABS_BASIS_BPS=25

# API Server
API_PORT=3100
ADMIN_API_TOKEN=your-secret-admin-token   # Required — secures all API routes except /health

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Session Management
SESSION_ID=truex-mm-session

# Heartbeat Intervals (seconds)
FIX_HEARTBEAT_INTERVAL=30
# Send one correlated TestRequest after 1.2 HeartBtInt without a valid inbound
# frame; require its matching Heartbeat within one additional HeartBtInt.
# The derived response window must remain at least 1000ms.
FIX_TEST_REQUEST_IDLE_MULTIPLIER=1.2
FIX_TEST_REQUEST_TIMEOUT_MULTIPLIER=1
FIX_LIVENESS_MAX_DETECTION_SECONDS=120
RECONNECT_INTERVAL=5000

# OHLC Configuration
OHLC_INTERVAL=1m
OHLC_FLUSH_INTERVAL=1000

# PostgreSQL Migration
PG_MIGRATION_INTERVAL=300000

# ── Connection Resilience & Alerting ─────────────────────────────────────────

# Slack webhook for quoting-halt alerts (FR-3.1)
DEFAULT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alert email destination
ALERT_EMAIL=ops@example.com

# CircleInbox email alerting (replaces Gmail SMTP) + dashboard magic links
CIRCLEINBOX_API_KEY=your-circleinbox-api-key
ALERT_FROM_EMAIL=alerts@derivative.email   # optional, sender address

# Telnyx SMS alerting
TELNYX_API_KEY=KEY0your-telnyx-api-key
TELNYX_FROM_NUMBER=+1XXXXXXXXXX   # E.164 format
ALERT_PHONE=+1XXXXXXXXXX          # SMS destination, E.164 format

# Alert deduplication window (ms). Default: 600000 (10 minutes)
ALERT_COOLDOWN_MS=600000

# MD staleness threshold (ms). Cancel all orders if no MD update for this long. Default: 10000
MD_STALE_THRESHOLD_MS=10000

# Quoting idle threshold (ms). Watchdog fires if no reprice for this long. Default: 120000
QUOTING_IDLE_THRESHOLD_MS=120000

# FIX logon-reset fallback. If the OE/MD session resume loops on a counterparty
# FIX-gateway restart (we get GapFill but never Logon-Ack), after this many
# consecutive logon timeouts the client retries once with ResetSeqNumFlag=Y
# (141=Y) and seqnum=1 to force a fresh session. Default: enabled, threshold=3.
# Loop guard: after FIX_MAX_LOGON_RESET_FALLBACKS reset-fallbacks fire in a row
# without a successful Logon-Ack, the client stops retrying resets (real cause
# is elsewhere) and emits `logon-reset-fallback-exhausted` for ops escalation.
# Set FIX_LOGON_RESET_FALLBACK=false to disable the fallback entirely.
FIX_LOGON_RESET_FALLBACK=true
FIX_LOGON_RESET_THRESHOLD=3
FIX_MAX_LOGON_RESET_FALLBACKS=3

# Strict startup verification for exchange orders still cancel-pending.
# Both values are positive integer milliseconds; interval must not exceed timeout.
TRUEX_STARTUP_CANCEL_VERIFY_TIMEOUT_MS=30000
TRUEX_STARTUP_CANCEL_VERIFY_INTERVAL_MS=500
